# API Configuration

# OPTION 1: Use this if Nginx ONLY serves the frontend, and the backend is accessed directly on port 5000.
VITE_API_URL=/api

# OPTION 2: Use this if Nginx acts as a reverse proxy for the backend as well (e.g. location /api -> http://localhost:5000).
# In this case, you don't need the port.
# VITE_API_URL=http://102.218.2.58/api
# Or relatively:
# VITE_API_URL=/api
